# Copy to .env.local and fill in to make the quote form send real emails.
# Get a key at https://resend.com (free tier is enough for a quote form).
RESEND_API_KEY=
# Inbox that receives quote requests.
QUOTE_TO_EMAIL=
# Verified sender on your Resend domain, e.g. "Kitout Website <quotes@yourdomain.com>"
QUOTE_FROM_EMAIL=
