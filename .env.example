# Copy to .env.local and fill in to make the quote form send real emails.
# Get a key at https://resend.com (free tier is enough for a quote form).
RESEND_API_KEY=
# Sender address on the domain verified in Resend (kitoutcontainer.com).
QUOTE_FROM_EMAIL="Kit Out Website <quotes@kitoutcontainer.com>"
# Optional. Quote requests go to info@kitoutcontainer.com unless this is set.
QUOTE_TO_EMAIL=

# SEO. The site's real address, used for canonical links, the sitemap and structured data.
# Leave empty to use https://kitoutcontainer.netlify.app; set to https://kitoutcontainer.com
# once that domain points at this site.
NEXT_PUBLIC_SITE_URL=
# Verification codes from Google Search Console and Bing Webmaster Tools (the content="" value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
